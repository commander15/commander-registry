{
  "version": "2.2.1",
  "build": {
    "type": "cmake",
    "generator": "Ninja",
    "targets": {
      "build": "all",
      "install": "install",
      "_package": "package"
    },
    "vars": {
      "RESTLINK_BUILD_CLI": "ON",
      "RESTLINK_BUILD_QML": "ON",
      "RESTLINK_BUILD_TRANSLATIONS": "ON",
      "RESTLINK_BUILD_TESTS": "OFF",
      "RESTLINK_BUILD_EXAMPLES": "OFF",
      "BUILD_SHARED_LIBS": "ON"
    },
    "runtime": {
      "vars": {
        "CMAKE_BUILD_TYPE": "Release",
        "RESTLINK_BUILD_DOCS": "OFF"
      }
    },
    "dev": {
      "vars": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RESTLINK_BUILD_DOCS": "ON"
      }
    }
  },
  "artifacts": {
    "source": {
      "type": "git",
      "repository": "https://github.com/commander15/RestLink.git",
      "tag": "v2.2.1"
    }
  }
}
